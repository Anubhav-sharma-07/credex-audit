# SpendLens Environment Configuration Example
# Copy to .env.local for local development: cp .env.example .env.local

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase REST & Auth Gateway
# For local dev / testing, placeholder mock credentials can be used.
NEXT_PUBLIC_SUPABASE_URL="https://mock.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="mock-anon-key"
SUPABASE_SERVICE_ROLE_KEY="mock-service-role-key"

# Cryptographic Master Key for OAuth Token Envelope Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=

# CSRF HMAC Secret for Mutation Verification (generate with: openssl rand -hex 32)
CSRF_SECRET=

# Optional: Claude 3.5 Sonnet API Key for AI Insights
# ANTHROPIC_API_KEY="sk-ant-api03-..."

# Optional: Sentry Crash Reporting Ingest DSN
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Optional: Log Level (trace, debug, info, warn, error)
LOG_LEVEL="info"

